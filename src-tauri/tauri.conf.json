{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Manager",
  "version": "0.14.2",
  "identifier": "com.tokenlens.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Token Manager",
        "decorations": false,
        "center": true,
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 650
      },
      {
        "label": "floating",
        "title": "Token Manager 悬浮窗",
        "url": "index.html",
        "width": 430,
        "height": 390,
        "minWidth": 300,
        "minHeight": 96,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCMTY0NjMyQUZEQUZBNkYKUldSdit0cXZNa1lXaXlYckdQRnErdjFDeU91YmxYaFE1eWpNMlVFbzRLWWl6M0JQSVppTzFTUlQK",
      "endpoints": [
        "https://token-manager-cloud.netlify.app/v1/update/stable"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
