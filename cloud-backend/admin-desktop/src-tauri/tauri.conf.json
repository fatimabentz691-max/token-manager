{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Manager Admin",
  "version": "0.11.10",
  "identifier": "com.tokenmanager.admin",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Token Manager Admin",
        "url": "https://token-manager-cloud.netlify.app/admin/",
        "center": true,
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
